---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="ARMAAN AHMAD ANSARI // Portfolio"
    description="Personal portfolio, vault, and digital playground of Armaan Ahmad Ansari."
    ogImage="/assets/pfp.jpg"
    preloadImage="/assets/pfp.webp"
    appleTouch
    css={['/style.css']}
>
    <a class="skip-link" href="#home">Skip to content</a>

    <!-- Navbar -->
    <nav class="vertical-spine">
        <div class="scroll-progress" id="scroll-progress"></div>
        <div class="spine-logo" id="nav-vibeplayer" style="cursor: pointer;" title="Access VIBEPLAYER"><span class="logo-icon">✦</span></div>
        <div class="spine-links">
            <a href="#about" class="spine-tab" data-section="about">ABOUT</a>
            <a href="#services" class="spine-tab" data-section="services">FOCUS</a>
            <a href="#portfolio" class="spine-tab" data-section="portfolio">WORKS</a>
            <a href="#contact" class="spine-tab" data-section="contact">CONTACT</a>
        </div>
    </nav>

    <!-- Dynamic Dotted Grid Background -->
    <canvas id="dynamic-bg-grid"></canvas>

    <!-- Background Doodle Container -->
    <div id="doodle-container"></div>

    <main>
        <!-- Brutalist Hero Section -->
        <section id="home" class="hero brutal-hero">
            <!-- Diagonal Brutalist Marquee -->
            <div class="brutal-marquee-container">
                <div class="brutal-marquee-track">
                    <span>VIBECODING // AOSP // LINUX // NEUBRUTALISM // </span>
                    <span>VIBECODING // AOSP // LINUX // NEUBRUTALISM // </span>
                </div>
            </div>

            <div class="hero-bg-glow"></div>
            <canvas id="hero-particles" class="hero-particles"></canvas>

            <!-- Massive Typographic Name overlaying everything -->
            <div class="brutal-name-layer">
                <h1 class="brutal-name-text reveal">ARMAAN<br>AHMAD<br>ANSARI</h1>
            </div>

            <div class="brutal-split section-spacing">
                <!-- Left: Text Content -->
                <div class="brutal-text-box sketchy-box">
                    <p class="hero-bio reveal delay-200">
                        I'm a <span id="age-span">15</span>-year-old developer from India, currently surviving 11th-grade
                        Computer Science (mostly by vibecoding). I spend an unhealthy amount of time compiling AOSP,
                        building Custom Android ROMs, and daily-driving Linux. I write code, break things, and occasionally fix them.
                    </p>
                    <div class="typing-container reveal delay-300">
                        <span class="typing-prefix">// </span><span id="typing-role"></span><span class="typing-cursor-blink">_</span>
                    </div>
                    <div class="hero-actions reveal delay-400">
                        <a href="#portfolio" class="btn-primary btn-work" aria-label="See Portfolio">
                            See My Work
                            <span class="btn-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                            </span>
                        </a>
                        <a href="#contact" class="btn-secondary" aria-label="Contact Me">Get in Touch</a>
                    </div>
                </div>

                <!-- Right: Profile Picture -->
                <div class="brutal-profile">
                    <div class="profile-img-container sketchy-box reveal">
                        <picture>
                            <source srcset="/assets/pfp.webp" type="image/webp" />
                            <img src="/assets/pfp.jpg" alt="Armaan Ahmad Ansari Profile Photo"
                                class="profile-img brutal-img" width="512" height="512" fetchpriority="high" />
                        </picture>
                        <div class="floating-badge brutal-badge">✦ armevox</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Bento About Section -->
        <section id="about" class="section-spacing">
            <h2 class="section-title reveal" data-scramble>Digital Arsenal &<br>After-Hours</h2>

            <div class="bento-grid-system">
                <!-- Arch Terminal Box -->
                <div class="bento-card-item sketchy-box span-2 reveal terminal-card" id="arch-terminal">
                    <div class="wireframe-label">[SYS:TERM-SPAN2]</div>
                    <div class="terminal-header">
                        <div class="term-dots">
                            <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
                        </div>
                        <span class="term-title">armaan@archlinux:~</span>
                    </div>
                    <div class="terminal-body">
                        <div class="term-line">
                            <span class="term-prompt">[armaan@archlinux ~]$</span>
                            <span class="term-cmd type-cmd">./status.sh</span>
                        </div>
                        <div class="term-output" id="arch-output"></div>
                        <div class="term-line hidden-prompt" id="arch-prompt-2">
                            <span class="term-prompt">[armaan@archlinux ~]$</span>
                            <input class="term-input" id="arch-input" type="text"
                                autocomplete="off" spellcheck="false" aria-label="Terminal command input" />
                        </div>
                    </div>
                </div>

                <!-- Core Tech Stack Box -->
                <div class="bento-card-item sketchy-box reveal delay-100" id="core-stack-card">
                    <div class="wireframe-label">[DEV:FULL-STACK]</div>
                    <div class="bento-label">Core Tech Stack</div>
                    <h3 class="raw-tag" data-tag="h3" style="margin-bottom: 0.6rem;">Full-Stack & Systems</h3>
                    
                    <!-- Interactive Category Filter -->
                    <div class="stack-category-pills">
                        <button type="button" class="stack-pill active" data-cat="all">ALL</button>
                        <button type="button" class="stack-pill" data-cat="frontend">FRONTEND</button>
                        <button type="button" class="stack-pill" data-cat="backend">BACKEND</button>
                        <button type="button" class="stack-pill" data-cat="systems">SYSTEMS</button>
                    </div>

                    <!-- Tech Badges Grid -->
                    <div class="stack-badges-grid" id="stack-badges-container">
                        <!-- Frontend: Powers This Site, Kizamu, Math Titan -->
                        <div class="stack-badge-item" data-cat="frontend" data-name="TypeScript" data-desc="Primary typed language powering This Site, Kizamu, and Math Titan">
                            <span class="stack-tag-code">TS</span>
                            <span class="stack-tag-name">TypeScript</span>
                        </div>
                        <div class="stack-badge-item" data-cat="frontend" data-name="Astro (SSR)" data-desc="Engine powering this site: Armevox Portfolio & File Vault">
                            <span class="stack-tag-code">ASTRO</span>
                            <span class="stack-tag-name">Astro (SSR)</span>
                        </div>
                        <div class="stack-badge-item" data-cat="frontend" data-name="React / Next.js" data-desc="Component framework powering Kizamu Sanctuary & ArmChat">
                            <span class="stack-tag-code">REACT</span>
                            <span class="stack-tag-name">React / Next</span>
                        </div>
                        <div class="stack-badge-item" data-cat="frontend" data-name="HTML5 & CSS3" data-desc="Modern CSS3 & layout architecture powering all portfolio sites">
                            <span class="stack-tag-code">UI</span>
                            <span class="stack-tag-name">HTML5 / CSS3</span>
                        </div>
                        <div class="stack-badge-item" data-cat="frontend" data-name="JavaScript" data-desc="Vanilla DOM and algorithm engine for QR Matrix Encoder">
                            <span class="stack-tag-code">JS</span>
                            <span class="stack-tag-name">JavaScript</span>
                        </div>

                        <!-- Backend & Cloud: Powers Serverless, AI Bot, Packet Sniffer -->
                        <div class="stack-badge-item" data-cat="backend" data-name="Java" data-desc="Object-oriented backend services, AOSP framework, and robust systems architecture">
                            <span class="stack-tag-code">JAVA</span>
                            <span class="stack-tag-name">Java</span>
                        </div>
                        <div class="stack-badge-item" data-cat="backend" data-name="Python" data-desc="Backend microservices, AsyncIO, and Groq LLM agent powering Amixi Sentinel AI">
                            <span class="stack-tag-code">PY</span>
                            <span class="stack-tag-name">Python</span>
                        </div>
                        <div class="stack-badge-item" data-cat="backend" data-name="Node.js" data-desc="Serverless API runtime powering this site and ArmChat Oasis">
                            <span class="stack-tag-code">NODE</span>
                            <span class="stack-tag-name">Node.js</span>
                        </div>
                        <div class="stack-badge-item" data-cat="backend" data-name="Go (Golang)" data-desc="Raw network socket listener powering Packet Sniffer CLI">
                            <span class="stack-tag-code">GO</span>
                            <span class="stack-tag-name">Go (Golang)</span>
                        </div>
                        <div class="stack-badge-item" data-cat="backend" data-name="WebSockets" data-desc="Bi-directional real-time communication in ArmChat Oasis">
                            <span class="stack-tag-code">WS</span>
                            <span class="stack-tag-name">WebSockets</span>
                        </div>
                        <div class="stack-badge-item" data-cat="backend" data-name="Turso & Supabase" data-desc="Turso SQLite for this site; Supabase Postgres for Kizamu">
                            <span class="stack-tag-code">SQL</span>
                            <span class="stack-tag-name">Turso & Supabase</span>
                        </div>

                        <!-- Systems & Low-Level: Powers SDM660 Kernel, AOSP, Linux -->
                        <div class="stack-badge-item" data-cat="systems" data-name="C (Kernel)" data-desc="Low-level kernel programming for Xiaomi SDM660">
                            <span class="stack-tag-code">C</span>
                            <span class="stack-tag-name">C (Kernel)</span>
                        </div>
                        <div class="stack-badge-item" data-cat="systems" data-name="ARM64 Assembly" data-desc="Assembly tuning and hardware optimization for AOSP / Kernel">
                            <span class="stack-tag-code">ASM</span>
                            <span class="stack-tag-name">ARM64 Asm</span>
                        </div>
                    </div>

                    <!-- Context Footer -->
                    <div class="stack-context-footer">
                        <span class="stack-dot-live">●</span>
                        <div id="stack-context-desc">
                            <strong>Powers:</strong> Java & Python backends, this site (Astro + Turso + Dropbox), Kizamu, Amixi AI, & SDM660 Kernel.
                        </div>
                    </div>
                </div>

                <!-- Music Box -->
                <div class="bento-card-item sketchy-box reveal delay-200 bg-yellow caution-tape" id="music-card">
                    <div class="wireframe-label">[VIBE:AUDIO-SYS]</div>
                    <div class="bento-label">Vibe</div>
                    <h3 class="raw-tag" data-tag="h3">Indie Soul</h3>
                    <p class="raw-tag" data-tag="p">Audiophile tendencies and a deep love for indie music that the mainstream would probably call "slightly weird."</p>
                </div>

                <!-- Gaming Box -->
                <div class="bento-card-item sketchy-box reveal delay-300" id="gaming-card">
                    <div class="wireframe-label">[CTRL:GAMING]</div>
                    <div class="konami-hint">↑ ↑ ↓ ↓ ← → ← → B A</div>
                    <div class="bento-label">The Lobby</div>
                    <h3 class="raw-tag" data-tag="h3">Gaming</h3>
                    <p class="raw-tag" data-tag="p">Minecraft, GTA V, and COD. Testing 3 AM reflexes when the terminal gets too quiet.</p>
                </div>

                <!-- Fun Fact Box -->
                <div class="bento-card-item sketchy-box reveal delay-200 bg-dark caution-tape-alt" id="fun-fact-card">
                    <div class="wireframe-label">[DATA:TRIVIA]</div>
                    <button class="fact-shuffle" id="fact-shuffle" aria-label="Show a new random fact" title="New fact">⤨</button>
                    <div class="bento-label">Random Insight</div>
                    <div class="fact-icon">✦</div>
                    <h3 id="fun-fact-text" class="raw-tag" data-tag="h3">Loading trivia...</h3>
                    <p class="fact-sub raw-tag" data-tag="p">Hit shuffle for a new fact</p>
                </div>

                <!-- Polyglot Box -->
                <a href="https://github.com/BlueTheBoss" target="_blank"
                    class="bento-card-item sketchy-box span-2 reveal delay-100 bg-footer"
                    id="polyglot-card"
                    style="text-decoration: none; color: inherit;">
                    <div class="wireframe-label">[URL:EXTERNAL-SPAN2]</div>
                    <div class="bento-label">Experience</div>
                    <h3 class="raw-tag" data-tag="h3">The Polyglot Spirit</h3>
                    <p class="raw-tag" data-tag="p" style="color: var(--text-footer);">Check my GitHub for the dozen other languages I've "experimented" with. Curiosity is my main operating system.</p>
                </a>
            </div>
        </section>

        <!-- Marquee Section (Single Track) -->
        <section class="brutal-marquee-wrapper">
            <div class="marquee-track track-single bg-accent">
                <div class="marquee-content marquee-text-solid">
                    <span>FULL STACK ALCHEMIST ✦</span>
                    <span>LINUX EXTREMIST ✦</span>
                    <span>BRUTALIST AESTHETIC ✦</span>
                    <span>TERMINAL DWELLER ✦</span>
                    <span>MIDNIGHT CODER ✦</span>
                    <!-- Duplicate for seamless scroll -->
                    <span aria-hidden="true">FULL STACK ALCHEMIST ✦</span>
                    <span aria-hidden="true">LINUX EXTREMIST ✦</span>
                    <span aria-hidden="true">BRUTALIST AESTHETIC ✦</span>
                    <span aria-hidden="true">TERMINAL DWELLER ✦</span>
                    <span aria-hidden="true">MIDNIGHT CODER ✦</span>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section id="services" class="services section-spacing">
            <h2 class="section-title services-title reveal" data-scramble>
                My Specialized Curiosities<br>& Midnight Obsessions
            </h2>

            <div class="services-container">
                <!-- Receipt Stats Column -->
                <div class="receipt-column reveal-left">
                    <div class="receipt-edge receipt-top"></div>
                    <div class="receipt-body">
                        <div class="receipt-header">
                            <span class="receipt-meta">[PRNT: SYS_METRICS]</span>
                            <span class="receipt-meta">[ID: 0x9F4A]</span>
                        </div>

                        <div class="receipt-item border-bottom-receipt">
                            <h3 class="stat-num receipt-num" data-target="10" data-suffix="+">0+</h3>
                            <p class="receipt-label">Projects Built</p>
                        </div>
                        <div class="receipt-item">
                            <h3 class="stat-num receipt-num" data-target="3" data-suffix="+">0+</h3>
                            <p class="receipt-label">Years of Code</p>
                        </div>

                        <div class="receipt-footer">
                            <div class="receipt-barcode">|||| ||| | || ||| || ||</div>
                            <span class="receipt-meta">[END OF TICKET]</span>
                        </div>
                    </div>
                    <div class="receipt-edge receipt-bottom"></div>
                </div>

                <!-- Filing Cabinet Accordion (Idea 1 + Idea 2 Fusion) -->
                <div class="filing-cabinet">

                    <!-- Folder 1 -->
                    <div class="folder-item">
                        <button class="folder-tab">
                            <span class="folder-index">01</span>
                            <span class="folder-title">AOSP & CUSTOM ROMS</span>
                            <span class="folder-icon">+</span>
                        </button>
                        <div class="folder-content">
                            <div class="folder-content-inner terminal-box">
                                <p>> Compiling Android from source and squeezing every drop of performance out of hardware that was never meant to run this fast.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Folder 2 -->
                    <div class="folder-item">
                        <button class="folder-tab">
                            <span class="folder-index">02</span>
                            <span class="folder-title">LINUX & SELF-HOSTING</span>
                            <span class="folder-icon">+</span>
                        </button>
                        <div class="folder-content">
                            <div class="folder-content-inner terminal-box">
                                <p>> The cloud is just someone else's computer. I prefer mine sitting in a corner, occasionally catching fire, and running Linux.</p>
                                <!-- Live Uptime Clock -->
                                <div class="live-uptime-container">
                                    <span class="uptime-label">SERVER UPTIME:</span>
                                    <span class="uptime-clock" id="server-uptime">00:00:00:00</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Folder 3 -->
                    <div class="folder-item">
                        <button class="folder-tab">
                            <span class="folder-index">03</span>
                            <span class="folder-title">VIBECODING</span>
                            <span class="folder-icon">+</span>
                        </button>
                        <div class="folder-content">
                            <div class="folder-content-inner terminal-box">
                                <p>> The sacred art of writing questionable code at 3 AM while the VibePlayer keeps the sanity in check. Aesthetic first, logic later.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Folder 4 -->
                    <div class="folder-item">
                        <button class="folder-tab">
                            <span class="folder-index">04</span>
                            <span class="folder-title">THE CS GRIND</span>
                            <span class="folder-icon">+</span>
                        </button>
                        <div class="folder-content">
                            <div class="folder-content-inner terminal-box">
                                <p>> Navigating the labyrinth of 11th-grade CS. Learning the ancient spells of systems, low-level logic, and why semi-colons hate me.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Folder 5 -->
                    <div class="folder-item">
                        <button class="folder-tab">
                            <span class="folder-index">05</span>
                            <span class="folder-title">MUSIC ADDICT</span>
                            <span class="folder-icon">+</span>
                        </button>
                        <div class="folder-content">
                            <div class="folder-content-inner terminal-box">
                                <p>> Let's be real: My terminal is just a background for my playlists. Everything else comfortably takes second place.</p>
                                <!-- CSS Equalizer -->
                                <div class="css-equalizer">
                                    <div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Folder 6 -->
                    <div class="folder-item">
                        <button class="folder-tab">
                            <span class="folder-index">06</span>
                            <span class="folder-title">MOON & MOVIES</span>
                            <span class="folder-icon">+</span>
                        </button>
                        <div class="folder-content">
                            <div class="folder-content-inner terminal-box">
                                <p>> Lover of celestial bodies and cinematic masterpieces. If I'm not at the desk, I'm probably moon-gazing or lost in a plot twist.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Portfolio Section -->
        <section id="portfolio" class="portfolio section-spacing">
            <div class="portfolio-header reveal">
                <h2 class="section-title" data-scramble>
                    My <span class="bordered-text">Projects & Designs</span>
                </h2>
            </div>

            <div class="directory-list">
                <!-- Project 5: Kizamu -->
                <div class="dir-row reveal">
                    <div class="dir-header">
                        <span class="dir-perms">-rwxr-xr-x</span>
                        <span class="dir-name">KIZAMU_SANCTUARY.EXE</span>
                    </div>
                    <div class="dir-content">
                        <p class="dir-desc">> Unified Productivity Sanctuary • Supabase Sync • AI-Assisted Notes</p>
                        <a href="https://armkizamu.vercel.app" target="_blank" class="dir-execute-btn">[EXECUTE_FILE]</a>
                    </div>
                </div>

                <!-- Project 1: Math Titan -->
                <div class="dir-row reveal delay-100">
                    <div class="dir-header">
                        <span class="dir-perms">-rwxr-xr-x</span>
                        <span class="dir-name">MATH_TITAN.SH</span>
                    </div>
                    <div class="dir-content">
                        <p class="dir-desc">> Math Mastery Platform • Gamified Challenges • Glassmorphism</p>
                        <a href="https://tabletitan.vercel.app" target="_blank" class="dir-execute-btn">[EXECUTE_FILE]</a>
                    </div>
                </div>

                <!-- Project 2: Amixi -->
                <div class="dir-row reveal delay-200">
                    <div class="dir-header">
                        <span class="dir-perms">-rwxr-xr-x</span>
                        <span class="dir-name">AMIXI_SENTINEL.PY</span>
                    </div>
                    <div class="dir-content">
                        <p class="dir-desc">> Telegram AI Assistant • Groq • Remembrance System</p>
                        <a href="https://amixi.vercel.app" target="_blank" class="dir-execute-btn">[EXECUTE_FILE]</a>
                    </div>
                </div>

                <!-- Project 3: ArmChat -->
                <div class="dir-row reveal">
                    <div class="dir-header">
                        <span class="dir-perms">-rwxr-xr-x</span>
                        <span class="dir-name">ARMCHAT_OASIS.BIN</span>
                    </div>
                    <div class="dir-content">
                        <p class="dir-desc">> Real-time Messaging • Digital Oasis Architecture</p>
                        <a href="https://armchat.vercel.app" target="_blank" class="dir-execute-btn">[EXECUTE_FILE]</a>
                    </div>
                </div>

                <!-- Project 7: Android Kernel -->
                <div class="dir-row reveal">
                    <div class="dir-header">
                        <span class="dir-perms">-rwxr-xr-x</span>
                        <span class="dir-name">SDM660_KERNEL_SOURCE.C</span>
                    </div>
                    <div class="dir-content">
                        <p class="dir-desc">> Custom Android Kernel • Xiaomi SDM660 • Hardware Optimization</p>
                        <a href="https://github.com/BlueTheBoss/android_kernel_xiaomi_sdm660_southwest-ng" target="_blank" class="dir-execute-btn">[EXECUTE_FILE]</a>
                    </div>
                </div>

            </div>

            <!-- Under Development -->
            <div class="dir-wip-header reveal">
                <span class="dir-perms">drwxr-xr-x</span>
                <span class="dir-name">UNDER_DEVELOPMENT/</span>
                <span class="wip-meta">2 processes running</span>
            </div>
            <div class="directory-list wip-list">
                <div class="dir-row wip reveal">
                    <div class="dir-header">
                        <span class="dir-perms">-rw-------</span>
                        <span class="dir-name">QR_MATRIX_ENCODER.JS</span>
                    </div>
                    <div class="dir-content">
                        <p class="dir-desc">> High-density dynamic QR generation • ECC recovery • Payload compression</p>
                        <span class="dir-execute-btn wip-badge">[ IN_DEV ]</span>
                    </div>
                </div>

                <div class="dir-row wip reveal delay-100">
                    <div class="dir-header">
                        <span class="dir-perms">-rw-------</span>
                        <span class="dir-name">PACKET_SNIFFER_CLI.GO</span>
                    </div>
                    <div class="dir-content">
                        <p class="dir-desc">> Raw socket listener • TCP/UDP packet analysis • Real-time terminal graphing</p>
                        <span class="dir-execute-btn wip-badge">[ IN_DEV ]</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section id="contact" class="cta-section section-spacing">
            <h2 class="section-title center-text reveal" data-scramble>Let's connect</h2>
            <p class="center-text section-sub reveal delay-100">find me on the interwebs, or drop a message into the void</p>

            <div class="hazard-billboard reveal-left delay-200">
                <div class="hazard-tape"></div>
                <div class="hazard-content">
                    <a href="https://t.me/armevox" target="_blank" class="hazard-btn">
                        TELEGRAM
                    </a>
                    <a href="https://instagram.com/armevox" target="_blank" class="hazard-btn">
                        INSTAGRAM
                    </a>
                    <a href="https://github.com/BlueTheBoss" target="_blank" class="hazard-btn">
                        GITHUB
                    </a>
                    <button type="button" class="hazard-btn" id="copy-email-btn" title="Copy email address">
                        EMAIL
                    </button>
                </div>
                <div class="hazard-tape"></div>
            </div>

            <div class="postcard-container reveal delay-300">
                <div class="postcard-header">
                    [ OFFICIAL COMMUNICATION DOCUMENT ]
                    <div class="postcard-stamp" aria-hidden="true">✦</div>
                </div>
                <form id="contact-form" class="postcard-form" novalidate>
                    <!-- Honeypot: hidden from humans, catnip for bots -->
                    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off"
                        style="position:absolute; left:-9999px; height:0; width:0; opacity:0;" aria-hidden="true" />
                    <div class="postcard-row">
                        <input type="text" id="name" placeholder="Identifier (Name)" required class="postcard-input" />
                        <input type="email" id="email" placeholder="Return Address (Email)" required class="postcard-input" />
                    </div>
                    <textarea id="message" placeholder="Enter Payload (Message)..." required class="postcard-input"
                        rows="4" maxlength="5000"></textarea>
                    <span class="msg-counter" id="msg-count">[ 0 / 5000 ]</span>
                    <button type="submit" class="postcard-submit" id="submit-btn">[ SUBMIT DOCUMENT ]</button>
                </form>
            </div>
        </section>
    </main>

    <footer class="footer black-bg">
        <div class="footer-monolith-container">
            <div class="footer-monolith reveal-monolith"><span class="monolith-inner">ARMAAN</span></div>
            <div class="footer-metadata">
                <div class="footer-meta-left">
                    <span id="secret-trigger" style="cursor: pointer; user-select: none;">✦</span>
                    SYS.LOG // ARMAAN AHMAD ANSARI © 2026
                </div>
                <div class="footer-meta-right">
                    <a href="#home" class="back-to-top">[ RETURN TO TOP_ ]</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Toast Notification -->
    <div id="toast" class="toast">
        <div class="toast-content sketchy-box">
            <span id="toast-message"></span>
            <button id="toast-close" aria-label="Close Notification">×</button>
        </div>
    </div>

    <!-- PIN Modal with Keypad for Secret Music Player -->
    <div id="pin-modal" class="pin-modal" role="dialog" aria-modal="true" aria-label="Secure access">
        <div class="pin-modal-content neubrutalism-box">
            <div class="pin-header">
                <div class="pin-lock-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="11" width="16" height="10" rx="2"></rect>
                        <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
                        <circle cx="12" cy="16" r="1.6" fill="currentColor" stroke="none"></circle>
                    </svg>
                </div>
                <div>
                    <h3 class="modal-title">Secure Access</h3>
                    <p class="modal-sub">VibePlayer // Audio Vault</p>
                </div>
            </div>

            <!-- Screen 1: where to? (shown every time the secret button is clicked) -->
            <div id="pin-destination" class="pin-destination">
                <p class="pin-dest-title">WHERE TO?</p>
                <div class="pin-dest-actions">
                    <button class="dest-btn" type="button" data-dest="/vault">VAULT</button>
                    <button class="dest-btn alt" type="button" data-dest="/music">VIBEPLAYER</button>
                </div>
                <p class="pin-dest-sub">PIN UNLOCK REQUIRED IF NOT ALREADY AUTHENTICATED</p>
            </div>

            <!-- Screen 2: PIN keypad (revealed after a destination is picked) -->
            <div class="pin-keypad-screen" id="pin-keypad-screen">
                <div class="pin-display" id="pin-dot-display">
                    <span class="pin-dot" id="dot-0"></span>
                    <span class="pin-dot" id="dot-1"></span>
                    <span class="pin-dot" id="dot-2"></span>
                    <span class="pin-dot" id="dot-3"></span>
                </div>
                <!-- Hidden input still used to track value in JS -->
                <input type="hidden" id="pin-input" maxlength="4" />

                <div class="keypad-grid">
                    <button class="key-btn" data-val="1">1</button>
                    <button class="key-btn" data-val="2">2</button>
                    <button class="key-btn" data-val="3">3</button>
                    <button class="key-btn" data-val="4">4</button>
                    <button class="key-btn" data-val="5">5</button>
                    <button class="key-btn" data-val="6">6</button>
                    <button class="key-btn" data-val="7">7</button>
                    <button class="key-btn" data-val="8">8</button>
                    <button class="key-btn" data-val="9">9</button>
                    <button class="key-btn clear" id="key-clear" aria-label="Clear">C</button>
                    <button class="key-btn" data-val="0">0</button>
                    <button class="key-btn cancel" id="pin-cancel" aria-label="Cancel">×</button>
                </div>

                <p id="pin-error" class="pin-error-msg" role="alert" aria-live="polite"></p>
                <button type="button" class="pin-back" id="pin-back">‹ BACK TO MENU</button>
            </div>
        </div>
    </div>
    <!-- SVG Filter for Wobble Effect -->
    <svg style="display: none;">
        <filter id="wobble" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="3" result="noise" id="wobble-noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </svg>

    <!-- SortableJS for Drag and Drop (pinned version) -->
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script is:inline defer src="/script.js"></script>
</BaseLayout>
