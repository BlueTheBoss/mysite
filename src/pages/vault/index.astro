---
import VaultLayout from '../../layouts/VaultLayout.astro';
import { requireVaultAuth } from '../../lib/requireAuth';

export const prerender = false;

const auth = requireVaultAuth(Astro.request);
if (!auth) return Astro.redirect('/', 302);

const now = new Date();
const serverDate = now.toLocaleDateString('en-GB', {
    weekday: 'short', day: 'numeric', month: 'short'
});
const serverTime = now.toLocaleTimeString('en-GB', {
    hour: '2-digit', minute: '2-digit'
});

const msLeft = Math.max(0, auth.expiresAt - Date.now());
const daysLeft = Math.floor(msLeft / 86_400_000);
const hoursLeft = Math.floor((msLeft % 86_400_000) / 3_600_000);
const vaultRoot = process.env.DROPBOX_VAULT_PATH || '/VibeVault';
---

<VaultLayout title="Command Center" active="dash" expiresAt={auth.expiresAt}>
    <!-- Refined HUD Metrics -->
    <div class="vault-hud">
        <div class="vault-metric">
            <div class="vault-metric-header">
                <span class="vault-metric-label">Security</span>
            </div>
            <div class="vault-metric-value">Authenticated</div>
            <div class="vault-metric-footer">HMAC-SHA256 · 30-Day TTL</div>
        </div>

        <div class="vault-metric">
            <div class="vault-metric-header">
                <span class="vault-metric-label">Session Remaining</span>
            </div>
            <div class="vault-metric-value">{daysLeft}d {hoursLeft}h</div>
            <div class="vault-metric-footer">Auto-revokes upon expiry</div>
        </div>

        <div class="vault-metric">
            <div class="vault-metric-header">
                <span class="vault-metric-label">System Clock</span>
            </div>
            <div class="vault-metric-value">{serverDate}, {serverTime}</div>
            <div class="vault-metric-footer">UTC / Server Time</div>
        </div>

        <div class="vault-metric">
            <div class="vault-metric-header">
                <span class="vault-metric-label">Storage Mount</span>
            </div>
            <div class="vault-metric-value">{vaultRoot}</div>
            <div class="vault-metric-footer">Encrypted Cloud Storage</div>
        </div>
    </div>

    <!-- Polished Bento Cards -->
    <div class="vault-bento">
        <!-- Notes Module -->
        <a href="/vault/notes" class="vault-card col-6">
            <div>
                <div class="vault-card-top">
                    <span class="vault-card-tag">Private Journal</span>
                    <span class="vault-card-code">MD</span>
                </div>
                <h2 class="vault-card-title">Notes</h2>
                <p class="vault-card-desc">
                    Personal encrypted notes and developer scratchpad stored directly in Dropbox. Rendered server-side with zero search engine indexing.
                </p>
            </div>
            <span class="vault-card-action">
                Open Notes &rarr;
            </span>
        </a>

        <!-- File Storage Module -->
        <a href="/vault/files" class="vault-card col-6">
            <div>
                <div class="vault-card-top">
                    <span class="vault-card-tag">Storage Enclave</span>
                    <span class="vault-card-code">FS</span>
                </div>
                <h2 class="vault-card-title">File Vault</h2>
                <p class="vault-card-desc">
                    Private cloud storage with chunked resumable upload pipeline, ephemeral download links, and instant deletion.
                </p>
            </div>
            <span class="vault-card-action">
                Browse Files &rarr;
            </span>
        </a>

        <!-- Ops Telemetry -->
        <a href="/vault/ops" class="vault-card col-4">
            <div>
                <div class="vault-card-top">
                    <span class="vault-card-tag">Monitoring</span>
                    <span class="vault-card-code">OPS</span>
                </div>
                <h2 class="vault-card-title">Telemetry</h2>
                <p class="vault-card-desc">
                    Inbound contact submissions, automated spam bot honeypot captures, and daily visitor analytics.
                </p>
            </div>
            <span class="vault-card-action">
                View Telemetry &rarr;
            </span>
        </a>

        <!-- VibePlayer Music Suite -->
        <a href="/music" class="vault-card col-4">
            <div>
                <div class="vault-card-top">
                    <span class="vault-card-tag">Audio Suite</span>
                    <span class="vault-card-code">AUDIO</span>
                </div>
                <h2 class="vault-card-title">VibePlayer</h2>
                <p class="vault-card-desc">
                    Stream your private Dropbox music library with real-time frequency analysis and native OS media controls.
                </p>
            </div>
            <span class="vault-card-action">
                Launch Player &rarr;
            </span>
        </a>

        <!-- Public Surface Exit -->
        <a href="/" class="vault-card col-4">
            <div>
                <div class="vault-card-top">
                    <span class="vault-card-tag">Public Surface</span>
                    <span class="vault-card-code">WEB</span>
                </div>
                <h2 class="vault-card-title">Portfolio</h2>
                <p class="vault-card-desc">
                    Return to the public portfolio. The vault remains completely unlinked and invisible to public visitors.
                </p>
            </div>
            <span class="vault-card-action">
                Go to Site &rarr;
            </span>
        </a>
    </div>
</VaultLayout>
