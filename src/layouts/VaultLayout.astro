---
// Shared chrome for all /vault pages in Midnight Fog.
// Verified server-side authentication with minimal, polished styling.
import BaseLayout from './BaseLayout.astro';

interface Props {
    title: string;
    active?: 'dash' | 'notes' | 'ops' | 'files';
    expiresAt: number; // epoch ms
    badge?: string;
}

const { title, active = 'dash', expiresAt, badge } = Astro.props;

const fmtDate = (ms: number) => {
    const d = new Date(ms);
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) +
        ', ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
};
const msLeft = Math.max(0, expiresAt - Date.now());
const daysLeft = Math.floor(msLeft / 86_400_000);
const hoursLeft = Math.floor((msLeft % 86_400_000) / 3_600_000);
---

<BaseLayout
    title={`${title} · Vault`}
    noindex
    theme="dark"
    fonts="all"
    cursor={false}
    track={false}
    css={['/style.css', '/vault.css']}
>
    <div class="vault-page">
        <!-- Sleek Header Navigation -->
        <header class="vault-header">
            <div class="vault-brand-wrap">
                <a href="/vault" class="vault-brand" title="Vault Dashboard">
                    ARMEVOX
                </a>
                <span class="vault-brand-badge">VAULT</span>
            </div>

            <nav class="vault-nav" aria-label="Vault navigation">
                <a href="/vault" class={`vault-nav-btn ${active === 'dash' ? 'active' : ''}`}>
                    Dashboard
                </a>
                <a href="/vault/notes" class={`vault-nav-btn ${active === 'notes' ? 'active' : ''}`}>
                    Notes
                </a>
                <a href="/vault/files" class={`vault-nav-btn ${active === 'files' ? 'active' : ''}`}>
                    Files
                </a>
                <a href="/vault/ops" class={`vault-nav-btn ${active === 'ops' ? 'active' : ''}`}>
                    Telemetry
                </a>
                <a href="/" class="vault-nav-btn exit-btn" title="Return to public portfolio">
                    Exit ↗
                </a>
                <button id="vault-logout" class="vault-nav-btn danger-btn" type="button" title="Sign out and revoke session">
                    Sign Out
                </button>
            </nav>
        </header>

        <!-- Main Page Container -->
        <main class="vault-main">
            <div class="vault-banner">
                <div class="vault-banner-left">
                    <h1 class="vault-title">{title}</h1>
                    <div class="vault-subtitle">
                        <span>Active Session</span>
                        <span>·</span>
                        <span>Expires {fmtDate(expiresAt)}</span>
                        <span>({daysLeft}d {hoursLeft}h remaining)</span>
                        {badge && <span>· {badge}</span>}
                    </div>
                </div>
            </div>

            <slot />
        </main>

        <!-- Toast Notifications -->
        <div id="vault-toast" class="vault-toast" role="status" aria-live="polite"></div>
    </div>

    <script is:inline>
        document.getElementById('vault-logout')?.addEventListener('click', async () => {
            try {
                await fetch('/api/session?logout');
            } catch { /* best-effort */ }
            window.location.href = '/';
        });

        window.__vaultToast = function (msg, kind) {
            kind = kind || 'ok';
            var el = document.getElementById('vault-toast');
            if (!el) return;
            el.textContent = msg;
            el.className = 'vault-toast shown ' + kind;
            setTimeout(function () {
                el.className = 'vault-toast ' + kind;
            }, 3200);
        };
    </script>
</BaseLayout>
