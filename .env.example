# Copy to .env and fill in your values — never commit the real .env

# PIN gate for VibePlayer and the /vault section
SECRET_PIN=

# Dropbox (refresh-token flow, recommended)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Static token fallback (not recommended)
DROPBOX_ACCESS_TOKEN=

# Folder paths inside your Dropbox (leading slash, optional)
DROPBOX_MUSIC_PATH=/Music
DROPBOX_VAULT_PATH=/VibeVault

# Resend — contact form + security alerts (optional; without it the contact
# form logs submissions to the server console instead of emailing)
RESEND_API_KEY=
